  "applicabilityEngine": [
    "Step 1: Determine HTTP Method",
    "Step 2: Determine Content Type",
    "Step 3: Determine Body Presence",
    "Step 4: Determine Authentication Requirement",
    "Step 5: Determine File Upload and XML Support",
    "Step 6: Determine Identifier Exposure",
    "Step 7: Select Applicable SASP Categories",
    "Step 8: Generate Security Scenarios"
  ],

  "structureFilters": [
    {
      "id": "NO_BODY",
      "when": "requestBody.present == false",
      "result": "mark NOT_APPLICABLE for SASP-12, SASP-17, SASP-18"
    },
    {
      "id": "NO_XML_SUPPORT",
      "when": "contentType.supportsXml == false",
      "result": "mark NOT_APPLICABLE for SASP-13"
    },
    {
      "id": "NO_IDENTIFIER_SURFACE",
      "when": "identifierSurface.present == false",
      "result": "mark NOT_APPLICABLE for SASP-23"
    },
    {
      "id": "NO_AUTH_REQUIRED",
      "when": "auth.required == false",
      "result": "mark NOT_APPLICABLE for SASP-08 unless anonymous-abuse scenario exists"
    },
    {
      "id": "NO_HEADER_BRANCH",
      "when": "endpoint.headerProcessing == false",
      "result": "mark NOT_APPLICABLE for SASP-19"
    },
    {
      "id": "NO_INPUT_SURFACE",
      "when": "pathParams.count == 0 && queryParams.count == 0 && requestBody.present == false",
      "result": "mark NOT_APPLICABLE for SASP-01, SASP-03, SASP-04, SASP-06, SASP-07, SASP-09, SASP-10"
    }
  ],

  "scenarioTemplate": {
    "requiredFields": [
      "securityTestId",
      "saspCategory",
      "riskLevel",
      "attackObjective",
      "preconditions",
      "requestManipulation",
      "expectedSecureBehaviour",
      "expectedStatus",
      "failureClassification",
      "automationPriority",
      "result"
    ],

    "allowedResultValues": [
      "PASS",
      "FAIL",
      "NOT_APPLICABLE"
    ],

    "notes": [
      "Generate security scenarios independently from functional RBAC scenarios.",
      "Never assume vulnerability existence; verify protection behaviour.",
      "Do not override enterprise expected status codes."
    ]
  },

  "agentGuidance": {
