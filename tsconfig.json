{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "playwright"]
  },
  "include": ["src", "tests", "playwright.config.ts"],
  "exclude": ["node_modules", "allure-report", "allure-results", "playwright-report", "test-results"]
}
